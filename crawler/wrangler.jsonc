// cyberspace-crawler: a Worker with no public routes, on Workers Paid (Queues). Deployed after the explorer's Worker by the CI/CD container (README.md, "Deploying").
// The database, bucket and queues are created once by the owner (crawler/README.md, "Setting it up once"); their ids go below.
// No secrets belong in this file.
{
  "name": "cyberspace-crawler",
  "account_id": "ab026008f5aa2bef2dca4cfccd0f70ef",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "preview_urls": false,
  // Every ten minutes, queue the addresses whose interval has passed.
  "triggers": { "crons": ["*/10 * * * *"] },
  "d1_databases": [
    // Shared with the explorer's Worker (wrangler.jsonc), which edits addresses and settings from /admin.
    { "binding": "DB", "database_name": "cyberspace", "database_id": "REPLACE-WITH-D1-DATABASE-ID" }
  ],
  "r2_buckets": [
    // space/<address id>/: each address's index, its views and what was collected for the AI step. fetch/: the HTTP cache's bodies.
    { "binding": "SPACE", "bucket_name": "cyberspace" }
  ],
  "queues": {
    "producers": [{ "binding": "SCANS", "queue": "cyberspace-scans" }],
    "consumers": [
      { "queue": "cyberspace-scans", "max_batch_size": 4, "max_batch_timeout": 30, "max_retries": 3, "dead_letter_queue": "cyberspace-scans-failed" }
    ]
  },
  "limits": { "cpu_ms": 120000 },
  "vars": {
    "USER_AGENT": "cyberspace-crawler/1.0 (+https://cyberspace-explorer.com/crawler)",
    "AI_MODEL": "claude-haiku-5-5"
  },
  // Secrets, set with `npx wrangler secret put … -c crawler/wrangler.jsonc`, never here:
  //   ANTHROPIC_API_KEY   the AI step; without it addresses are scanned but nothing is turned into views
  //   GITHUB_TOKEN        optional: raises GitHub's limit from 60 to 5,000 requests an hour; read-only, public repositories
  //   GITLAB_TOKEN        optional: the same for gitlab.com
  "observability": { "enabled": true }
}
