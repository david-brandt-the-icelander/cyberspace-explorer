// The cyberspace explorer, a Worker on a domain of its own, cyberspace-explorer.com (README.md, "Deploying").
// A custom domain: Cloudflare creates the DNS record and the certificate on deploy.
// GitHub Actions deploys it on every push to main that changes this repository (.github/workflows/cyberspace-explorer.yml).
// No secrets belong in this file.
{
  "name": "cyberspace-explorer",
  "account_id": "ab026008f5aa2bef2dca4cfccd0f70ef",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "cyberspace-explorer.com", "custom_domain": true }],
  "vars": {
    // The OAuth App's registered callback is ${PUBLIC_ORIGIN}/auth/github/callback.
    "PUBLIC_ORIGIN": "https://cyberspace-explorer.com"
  },
  // Secrets, set with `wrangler secret put … -c wrangler.jsonc`, never here:
  //   GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET   the GitHub OAuth App; sign-in is off without them
  //   SESSION_SECRET                           a long random string that seals the cookies
  "observability": { "enabled": true }
}
