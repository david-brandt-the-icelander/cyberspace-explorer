// The cyberspace explorer, a Worker on a domain of its own, cyberspace-explorer.com (README.md, "Deploying").
// A custom domain: Cloudflare creates the DNS record and the certificate on deploy.
// The CI/CD container deploys it when main is green (README.md, "Deploying"; .dev/pipeline.json).
// No secrets belong in this file.
{
  "name": "cyberspace-explorer",
  "account_id": "ab026008f5aa2bef2dca4cfccd0f70ef",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "cyberspace-explorer.com", "custom_domain": true }],
  // Who the reader is: icelander.net's login service (the same Cloudflare account), app "explorer", callback
  // https://cyberspace-explorer.com/identity/auth/callback registered in its APPS. No secret is needed for it.
  // /admin needs that sign-in and its role explorer:admin, which the owners hold (worker/space.js), whatever
  // REQUIRE_SIGN_IN says.
  "services": [{ "binding": "ACCOUNTS", "service": "accounts", "entrypoint": "Internal" }],
  "vars": {
    // The GitHub OAuth App's registered callback is ${PUBLIC_ORIGIN}/auth/github/callback (unchanged: it only reads repositories).
    "PUBLIC_ORIGIN": "https://cyberspace-explorer.com",
    // "true": the page, /api/space and the GitHub routes need a sign-in to icelander.net. It is "false" until
    // icelander.net's accounts Worker (with the app "explorer", migrations 0002 and 0003) is deployed, because every
    // merge to main deploys this Worker; then set it to "true" and deploy. "false" is how it always was.
    "REQUIRE_SIGN_IN": "false",
    "ACCOUNTS_JWKS": "{\"keys\":[{\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"kid\":\"k2026a\",\"x\":\"WIEomi0LTalJvQndhD7abl8ty3YcliQ0vEz4XjLXayc\"}]}"
  },
  // The protocol page (/crawler) is docs/cyberspace-protocol.md, imported as text.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  // Shared with the crawler (crawler/wrangler.jsonc): its addresses and settings, what it collected, and its scan queue.
  "d1_databases": [{ "binding": "DB", "database_name": "cyberspace", "database_id": "REPLACE-WITH-D1-DATABASE-ID" }],
  "r2_buckets": [{ "binding": "SPACE", "bucket_name": "cyberspace" }],
  "queues": { "producers": [{ "binding": "SCANS", "queue": "cyberspace-scans" }] },
  // Secrets, set with `wrangler secret put … -c wrangler.jsonc`, never here:
  //   GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET   the GitHub OAuth App; sign-in is off without them
  //   SESSION_SECRET                           a long random string that seals the cookies
  "observability": { "enabled": true }
}
